# Albatross RAG Multi-Provider Configuration
# Add the keys you have available. The system dynamically adapts based on provided keys.

# Anthropic (Claude Opus / Sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Mistral AI (Mistral Large / Mistral Embed)
MISTRAL_API_KEY=your_mistral_api_key_here

# Groq (Free, ultra-fast Llama 3.3 70B for zero-cost testing)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Cohere Rerank (Free 1,000 calls/month tier)
COHERE_API_KEY=your_cohere_api_key_here

# Default Model Choice: groq | claude | mistral
DEFAULT_MODEL=groq
